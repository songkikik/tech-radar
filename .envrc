# data-pipeline/dbt/dbt_bq/.envrc 패턴 차용.
# watch_file: 매니페스트가 바뀌면 direnv 가 자동으로 uv sync 를 다시 돈다.
watch_file pyproject.toml uv.lock

uv sync --frozen --quiet

export VIRTUAL_ENV="$(pwd)/.venv"
PATH_add "$(pwd)/.venv/bin"

export DBT_PROFILES_DIR="$(pwd)/dbt/profiles"

# 기본 타깃은 dev (로컬 DuckDB 카탈로그 + ./data/lakehouse). 비용 0, 오프라인 동작.
export TECHRADAR_TARGET="${TECHRADAR_TARGET:-dev}"

# dbt 는 파이썬 config.py 를 읽을 수 없으므로 dev 경로를 env 로 넘긴다.
# config.py 도 같은 이름을 읽되, 미설정 시 REPO_ROOT 기준으로 폴백한다
# (direnv 없이 uv run 만으로도 동작해야 하므로).
export TECHRADAR_DEV_CATALOG="$(pwd)/data/catalog.ducklake"
export TECHRADAR_DEV_DATA_PATH="$(pwd)/data/lakehouse/"

# 시크릿(R2 키·Neon DSN·Slack webhook·Groq 키)은 gitignore 된 로컬 파일에서만 온다.
source_env_if_exists .envrc.local
